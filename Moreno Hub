MiscTab:CreateSection("Visuals")

local function setBGVisible()
    for _, model in pairs(workspace:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
            local hrp = model.HumanoidRootPart
            for _, obj in pairs(hrp:GetDescendants()) do
                if obj.Name == "BG" and obj:IsA("BodyGyro") then
                    obj.Parent = hrp
                    obj.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                end
            end
        end
    end
end

local function hideBG()
    for _, model in pairs(workspace:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
            for _, obj in pairs(model.HumanoidRootPart:GetDescendants()) do
                if obj.Name == "BG" and obj:IsA("BodyGyro") then
                    obj.Parent = nil
                end
            end
        end
    end
end

MiscTab:CreateToggle({
    Name = "Show BodyGyro",
    CurrentValue = false,
    Flag = "ShowBG",
    Callback = function(value)
        if value then setBGVisible() else hideBG() end
    end,
})

